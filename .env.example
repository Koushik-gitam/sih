# Copy to .env and adjust for the deployment site.

# HTTP listener
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Storage
# NAWI_DATA_DIR=/var/lib/nawi-r76          # report repository, uploads, generated files
# NAWI_SECRET_FILE=/var/lib/nawi-r76/session.secret

# Rule schema. Point this at a site-specific copy to keep laboratory-wide
# metrological limits under configuration control.
# NAWI_RULES_PATH=./rules/oiml-r76.json

# Sessions and uploads
SESSION_HOURS=12
NAWI_MAX_UPLOAD_BYTES=8388608

# Headless browser used to render PDF reports. Leave unset to auto-detect.
# CHROME_BIN=/usr/bin/google-chrome

# Set to 1 to suppress the per-request log line.
# NAWI_QUIET=1
